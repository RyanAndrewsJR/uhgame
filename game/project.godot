; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="uhgame"
run/main_scene="res://scenes/ui/hub.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://8fa0x06vw5xc"

[autoload]

GameFeel="*res://scripts/autoload/game_feel.gd"
Events="*res://scripts/autoload/events.gd"
WorldQuery="*res://scripts/autoload/world_query.gd"
Settings="*res://scripts/autoload/settings.gd"
Reactions="*res://scripts/autoload/reactions.gd"
Progress="*res://scripts/autoload/progress.gd"
Loot="*res://scripts/autoload/loot.gd"
Brains="*res://scripts/autoload/brains.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/at-icons/plugin.cfg")

