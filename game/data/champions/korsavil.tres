[sub_resource type="Resource" id="Passive_korsavil"]
script = ExtResource("5_passive")
display_name = "Passive"
description = "Every 4th strike of your chain gives you 2 stacks of Inevitable Demise (once every 5 seconds), up to 6. Each stack gives 2% movement speed, and they fade together 6 seconds after the last. At 4 stacks your next basic attack deals 50 + 75% AD bonus damage. The 4th strike also restores 10 Energy. You have two dashes."
icon_color = Color(0.62, 0.45, 0.95, 1)
modifiers = Array[ExtResource("4_stat_modifier")]([SubResource("StatModifier_second_dash")])
reaction_rules = Array[Resource]([ExtResource("6_rule")])
