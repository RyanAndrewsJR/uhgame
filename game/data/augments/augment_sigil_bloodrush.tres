[ext_resource type="Script" path="res://scripts/data/gameplay_effect.gd" id="4_effect"]
[ext_resource type="Resource" path="res://data/statuses/status_bloodrush.tres" id="5_bloodrush"]

[sub_resource type="Resource" id="rush"]
script = ExtResource("3_status")
