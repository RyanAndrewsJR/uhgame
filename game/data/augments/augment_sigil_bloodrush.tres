[gd_resource type="Resource" script_class="AbilityAugment" format=3]

[ext_resource type="Script" path="res://scripts/data/ability_augment.gd" id="1_augment"]
[ext_resource type="Script" path="res://scripts/data/reaction_rule.gd" id="2_rule"]
