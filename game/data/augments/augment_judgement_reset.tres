[gd_resource type="Resource" script_class="AbilityAugment" format=3]

[ext_resource type="Script" path="res://scripts/data/ability_augment.gd" id="1_augment"]
[ext_resource type="Script" path="res://scripts/data/reaction_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/data/modify_cooldown_gameplay_effect.gd" id="3_cooldown"]
[ext_resource type="Script" path="res://scripts/data/gameplay_effect.gd" id="4_effect"]

[sub_resource type="Resource" id="reset"]
script = ExtResource("3_cooldown")
ability_scope = &"ability:knight_judgement"
mode = 2

[sub_resource type="Resource" id="on_kill"]
script = ExtResource("2_rule")
id = &"judgement_reset"
trigger = 5
effects = Array[ExtResource("4_effect")]([SubResource("reset")])
effect_target = 1

[resource]
script = ExtResource("1_augment")
id = &"judgement_reset"
kind = 1
scope = &"ability:knight_judgement"
rules = Array[ExtResource("2_rule")]([SubResource("on_kill")])
display_name = "Judgement reset"
description = "A Judgement kill resets its cooldown."
