[gd_resource type="Resource" script_class="AbilityAugment" format=3]

[ext_resource type="Script" path="res://scripts/data/ability_augment.gd" id="1_augment"]
[ext_resource type="Resource" path="res://data/abilities/knight_e_lunge_return.tres" id="2_return"]

[resource]
script = ExtResource("1_augment")
id = &"lunge_return"
kind = 2
scope = &"ability:knight_lunge"
replacement = ExtResource("2_return")
display_name = "Homeward Lunge"
description = "Recast Lunge within 2.5 s to dash back to where it started. Its cooldown starts after the return."
