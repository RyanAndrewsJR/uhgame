[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/abilities/test_caster/guard.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/ai_use.gd" id="2_use"]
[ext_resource type="Script" path="res://scripts/data/condition.gd" id="3_condition"]

[sub_resource type="Resource" id="threatened"]
script = ExtResource("3_condition")
kind = 9
value = 1.0

[sub_resource type="Resource" id="use_defend"]
script = ExtResource("2_use")
intent = &"defend"
conditions = Array[ExtResource("3_condition")]([SubResource("threatened")])

[resource]
script = ExtResource("1_script")
id = &"test_caster_guard"
tags = Array[StringName]([&"defensive", &"buff"])
display_name = "Guard"
description = "A shield of {shield_amount} on itself for {shield_duration} s. It goes up only when the caster sees an attack coming at it."
icon_color = Color(0.85, 0.9, 1, 1)
targeting = 0
cooldown = 8.0
cast_time = 0.0
resets_auto_attack = false
ai_uses = Array[ExtResource("2_use")]([SubResource("use_defend")])
