[sub_resource type="Resource" id="fury_60"]
script = ExtResource("c1_condition")
kind = 6
value = 60.0

[sub_resource type="Resource" id="fury_stun"]
script = ExtResource("c3_modifier")
stat = &"stun_duration"
value = 0.5

[sub_resource type="Resource" id="fury_base_damage"]
script = ExtResource("c3_modifier")
stat = &"base_damage"
type = 1
value = 0.3

[sub_resource type="Resource" id="fury_ad_ratio"]
script = ExtResource("c3_modifier")
stat = &"ad_ratio"
type = 1
value = 0.3

[sub_resource type="Resource" id="fury_bonus"]
script = ExtResource("c2_bonus")
conditions = Array[ExtResource("c1_condition")]([SubResource("fury_60")])
modifiers = Array[ExtResource("c3_modifier")]([SubResource("fury_stun"), SubResource("fury_base_damage"), SubResource("fury_ad_ratio")])
description = "At 60+ Fury: +30% damage and +0.5s stun, and it consumes your Fury."

[sub_resource type="Resource" id="missing_health"]
script = ExtResource("2_scaling")
param = &"target_missing_health_ratio"
ratio = 0.2
of = 3

[resource]
script = ExtResource("1_script")
id = &"knight_judgement"
poise_damage = 40.0
tags = Array[StringName]([&"ultimate", &"channel"])
display_name = "Judgement"
supported_flags = Array[StringName]([&"judgement_shockwave", &"judgement_drag"])
description = "Strike an enemy for {damage} physical damage ({base_damage} {ratios}), and stun it for {stun_duration}s. Channel: moving cancels it. Walks into range if needed."
icon_color = Color(1, 0.35, 0.3, 1)
cast_style = 2
targeting = 3
cooldown = 30.0
cast_time = 0.75
cast_range = 450.0
cancel_on_move = true
base_damage = 150.0
ad_ratio = 1.0
scalings = Array[ExtResource("2_scaling")]([SubResource("missing_health")])
hit_shake = 6.0
hit_hitstop = 0.09
conditional_bonuses = Array[ExtResource("c2_bonus")]([SubResource("fury_bonus")])
cast_sound = ExtResource("s1_cast_sound")
hit_sound = ExtResource("s2_hit_sound")
ready_sound = ExtResource("s3_ready_sound")
cast_anim = &"1H_Melee_Attack_Chop"
