[resource]
script = ExtResource("1_script")
id = &"test_vector_line"
tags = Array[StringName]([&"core", &"line", &"vector"])
display_name = "Vector Line"
description = "Press to place the start up to {range} units away, drag to aim, release: a {vector_length}-unit line deals {damage} magic damage ({base_damage} {ratios}) to every enemy on it. A tap lays it from you through the start. Held {overhold_time}s, it fires on its own."
icon_color = Color(0.6, 0.95, 0.75, 1)
cast_style = 3
targeting = 2
cooldown = 3.0
cast_time = 0.2
cast_range = 500.0
roots_during_cast = false
dash_cancelable = true
cast_move_speed_multiplier = 0.6
base_damage = 60.0
ad_ratio = 0.5
damage_type = 1
hit_shake = 2.5
hit_hitstop = 0.04
