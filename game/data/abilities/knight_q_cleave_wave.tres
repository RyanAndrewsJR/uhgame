[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/abilities/knight/cleave_wave.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/sounds/sound_knight_cleave_cast.tres" id="s1_cast_sound"]
[ext_resource type="Script" path="res://scripts/data/condition.gd" id="c1_condition"]
[ext_resource type="Script" path="res://scripts/data/conditional_bonus.gd" id="c2_bonus"]
[ext_resource type="Script" path="res://scripts/data/stat_modifier.gd" id="c3_modifier"]
[ext_resource type="Script" path="res://scripts/data/charge_scaling.gd" id="h1_scaling"]
[ext_resource type="Curve" path="res://data/curves/curve_knight_cleave_heal.tres" id="h2_heal_curve"]

[sub_resource type="Resource" id="heal_by_missing_health"]
script = ExtResource("h1_scaling")
param = &"heal_on_hit_ratio"
min_fraction = 0.0
curve = ExtResource("h2_heal_curve")
input = &"self_missing_health"

[sub_resource type="Resource" id="staggered_target"]
script = ExtResource("c1_condition")
kind = 1
status_tag = &"staggered"

[sub_resource type="Resource" id="staggered_base_damage"]
script = ExtResource("c3_modifier")
stat = &"base_damage"
type = 1
value = 0.5

[sub_resource type="Resource" id="staggered_ad_ratio"]
script = ExtResource("c3_modifier")
stat = &"ad_ratio"
type = 1
value = 0.5

[sub_resource type="Resource" id="staggered_bonus"]
script = ExtResource("c2_bonus")
conditions = Array[ExtResource("c1_condition")]([SubResource("staggered_target")])
modifiers = Array[ExtResource("c3_modifier")]([SubResource("staggered_base_damage"), SubResource("staggered_ad_ratio")])
description = "+50% damage to Staggered enemies."

[resource]
script = ExtResource("1_script")
cast_sound = ExtResource("s1_cast_sound")
id = &"knight_cleave_wave"
tags = Array[StringName]([&"core", &"projectile"])
display_name = "Cleave Wave"
variant_of = &"knight_cleave"
description = "Send a wave of force up to {range} units ahead, dealing {damage} physical damage ({base_damage} {ratios}) to every enemy it passes through. Heals you for up to {heal_on_hit_ratio%} of the damage dealt, more the lower your health."
icon_color = Color(0.85, 0.9, 1, 1)
cooldown = 3.0
cast_time = 0.2
cast_range = 700.0
base_damage = 80.0
ad_ratio = 0.7
projectile_speed = 900.0
projectile_width = 150.0
projectile_pierce = 20
heal_on_hit_ratio = 0.55
charge_scalings = Array[ExtResource("h1_scaling")]([SubResource("heal_by_missing_health")])
conditional_bonuses = Array[ExtResource("c2_bonus")]([SubResource("staggered_bonus")])
