[ext_resource type="Script" uid="uid://rmkkourgx2vm" path="res://scripts/data/condition.gd" id="c1_condition"]
[ext_resource type="Script" uid="uid://effvdqcl7tjf" path="res://scripts/data/conditional_bonus.gd" id="c2_bonus"]
[ext_resource type="Script" uid="uid://cvwv2nrsbyrah" path="res://scripts/data/stat_modifier.gd" id="c3_modifier"]
[ext_resource type="Script" uid="uid://cmf5kh8knu8l7" path="res://scripts/data/charge_scaling.gd" id="h1_scaling"]
[ext_resource type="Curve" uid="uid://o3atmc4faada" path="res://data/curves/curve_knight_cleave_heal.tres" id="h2_heal_curve"]
[ext_resource type="Resource" path="res://data/sounds/sound_knight_cleave_cast.tres" id="s1_cast_sound"]

[sub_resource type="Resource" id="heal_by_missing_health"]
script = ExtResource("h1_scaling")
param = &"heal_missing_health_ratio"
min_fraction = 0.0
curve = ExtResource("h2_heal_curve")
input = &"self_missing_health"

[sub_resource type="Resource" id="staggered_target"]
script = ExtResource("c1_condition")
kind = 1
status_tag = &"staggered"

[sub_resource type="Resource" id="staggered_base_damage"]
script = ExtResource("c3_modifier")
stat = &"base_damage"
type = 1
value = 0.5

[sub_resource type="Resource" id="staggered_ad_ratio"]
script = ExtResource("c3_modifier")
stat = &"ad_ratio"
type = 1
value = 0.5

[sub_resource type="Resource" id="staggered_bonus"]
script = ExtResource("c2_bonus")
conditions = Array[ExtResource("c1_condition")]([SubResource("staggered_target")])
modifiers = Array[ExtResource("c3_modifier")]([SubResource("staggered_base_damage"), SubResource("staggered_ad_ratio")])
description = "+50% damage to Staggered enemies."

[resource]
script = ExtResource("1_script")
id = &"knight_cleave"
tags = Array[StringName]([&"area", &"core", &"cone", &"melee"])
display_name = "Cleave"
supported_flags = Array[StringName]([&"cleave_whirl", &"cleave_rend"])
description = "Sweep your sword in a wide arc in front of you, dealing {damage} physical damage ({base_damage} {ratios}) and knocking enemies back. Each cast that hits heals you for up to {heal_missing_health_ratio%} of your missing health, more the lower your health."
icon_color = Color(0.85, 0.9, 1, 1)
cooldown = 3.0
resource_cost = 20.0
charge_scalings = Array[ExtResource("h1_scaling")]([SubResource("heal_by_missing_health")])
cast_time = 0.2
base_damage = 80.0
ad_ratio = 0.7
hit_knockback_px = 17.0
heal_missing_health_ratio = 0.55
hit_shake = 3.0
hit_hitstop = 0.05
conditional_bonuses = Array[ExtResource("c2_bonus")]([SubResource("staggered_bonus")])
cast_sound = ExtResource("s1_cast_sound")
cast_anim = &"1H_Melee_Attack_Slice_Horizontal"
