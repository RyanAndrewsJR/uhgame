[ext_resource type="Script" path="res://scripts/data/condition.gd" id="c1_condition"]
[ext_resource type="Script" path="res://scripts/data/conditional_bonus.gd" id="c2_bonus"]
[ext_resource type="Script" path="res://scripts/data/stat_modifier.gd" id="c3_modifier"]

[sub_resource type="Resource" id="staggered_target"]
script = ExtResource("c1_condition")
kind = 1
status_tag = &"staggered"

[sub_resource type="Resource" id="staggered_base_damage"]
script = ExtResource("c3_modifier")
stat = &"base_damage"
type = 1
value = 0.5

[sub_resource type="Resource" id="staggered_ad_ratio"]
script = ExtResource("c3_modifier")
stat = &"ad_ratio"
type = 1
