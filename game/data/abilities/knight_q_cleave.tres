modifiers = Array[ExtResource("c3_modifier")]([SubResource("staggered_base_damage"), SubResource("staggered_ad_ratio")])
description = "+50% damage to Staggered enemies."

[resource]
script = ExtResource("1_script")
cast_sound = ExtResource("s1_cast_sound")
id = &"knight_cleave"
tags = Array[StringName]([&"area", &"core", &"cone"])
display_name = "Cleave"
description = "Sweep your sword in a wide arc in front of you, dealing {damage} physical damage ({base_damage} {ratios}) and knocking enemies back."
icon_color = Color(0.85, 0.9, 1, 1)
cooldown = 3.0
resource_cost = 20.0
cast_time = 0.2
base_damage = 80.0
ad_ratio = 0.7
hit_knockback_px = 17.0
hit_shake = 3.0
hit_hitstop = 0.05
conditional_bonuses = Array[ExtResource("c2_bonus")]([SubResource("staggered_bonus")])
