[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/abilities/test_skirmisher/leap.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/ai_use.gd" id="2_use"]
[ext_resource type="Resource" path="res://data/sounds/sound_slime_elite_slam_hit.tres" id="3_hit"]
[ext_resource type="Resource" path="res://data/sounds/sound_slime_elite_slam_telegraph.tres" id="4_telegraph"]

[sub_resource type="Resource" id="use_gap_close"]
script = ExtResource("2_use")
intent = &"gap_close"

[resource]
script = ExtResource("1_script")
id = &"test_skirmisher_leap"
tags = Array[StringName]([&"mobility", &"leap", &"area"])
display_name = "Leap"
description = "Marks a {radius_px} px circle beside the target, fills it over {cast_time} s, then leaps there over everything: {damage} physical damage to everyone still inside."
icon_color = Color(0.95, 0.75, 0.25, 1)
targeting = 2
cooldown = 6.0
cast_time = 0.5
cast_range = 600.0
resets_auto_attack = false
base_damage = 45.0
hit_sound = ExtResource("3_hit")
telegraph_sound = ExtResource("4_telegraph")
ai_uses = Array[ExtResource("2_use")]([SubResource("use_gap_close")])
