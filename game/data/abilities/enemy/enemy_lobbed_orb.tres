[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/abilities/slime/slam.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/ai_use.gd" id="2_use"]
[ext_resource type="Resource" path="res://data/sounds/sound_slime_elite_slam_hit.tres" id="3_hit"]
[ext_resource type="Resource" path="res://data/sounds/sound_slime_elite_slam_telegraph.tres" id="4_telegraph"]

[sub_resource type="Resource" id="use_poke"]
script = ExtResource("2_use")
intent = &"poke"

[sub_resource type="Resource" id="use_zone"]
script = ExtResource("2_use")
intent = &"zone"

[resource]
script = ExtResource("1_script")
radius_px = 48.0
knockback_px = 0.0
telegraph_color = Color(0.75, 0.45, 1, 1)
hitstop = 0.03
shake = 1.0
id = &"enemy_lobbed_orb"
tags = Array[StringName]([&"core", &"area"])
display_name = "Lobbed orb"
description = "Marks a {radius_px} px circle where the target stands, up to {range} units away, fills it over {cast_time} s, then the orb lands: {damage} magic damage to everyone inside."
icon_color = Color(0.75, 0.45, 1, 1)
targeting = 2
cooldown = 5.0
cast_time = 1.0
cast_range = 900.0
resets_auto_attack = false
base_damage = 40.0
damage_type = 1
hit_sound = ExtResource("3_hit")
telegraph_sound = ExtResource("4_telegraph")
ai_uses = Array[ExtResource("2_use")]([SubResource("use_poke"), SubResource("use_zone")])
