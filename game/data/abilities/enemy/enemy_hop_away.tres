[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/abilities/enemy/hop_away.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/ai_use.gd" id="2_use"]

[sub_resource type="Resource" id="use_escape"]
script = ExtResource("2_use")
intent = &"escape"

[resource]
script = ExtResource("1_script")
hop_time = 0.15
id = &"enemy_hop_away"
tags = Array[StringName]([&"mobility", &"dash"])
display_name = "Hop away"
description = "Hops up to {range} units straight away from its target in {hop_time} s."
icon_color = Color(0.95, 0.85, 0.4, 1)
targeting = 2
cooldown = 8.0
cast_time = 0.0
cast_range = 300.0
resets_auto_attack = false
ai_uses = Array[ExtResource("2_use")]([SubResource("use_escape")])
