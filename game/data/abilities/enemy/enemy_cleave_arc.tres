[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/abilities/enemy/cleave_arc.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/ai_use.gd" id="2_use"]
[ext_resource type="Script" path="res://scripts/data/condition.gd" id="3_condition"]
[ext_resource type="Resource" path="res://data/sounds/sound_slime_elite_slam_hit.tres" id="4_hit"]
[ext_resource type="Resource" path="res://data/sounds/sound_slime_elite_slam_telegraph.tres" id="5_telegraph"]

[sub_resource type="Resource" id="use_damage"]
script = ExtResource("2_use")
intent = &"damage"
weight = 1.1

[sub_resource type="Resource" id="two_champions"]
script = ExtResource("3_condition")
kind = 5
count = 2
radius = 250.0

[sub_resource type="Resource" id="use_zone"]
script = ExtResource("2_use")
intent = &"zone"
conditions = Array[ExtResource("3_condition")]([SubResource("two_champions")])

[resource]
script = ExtResource("1_script")
half_angle_deg = 60.0
id = &"enemy_cleave_arc"
tags = Array[StringName]([&"core", &"area", &"cone"])
display_name = "Cleave arc"
description = "Fills a cone {half_angle_deg} degrees to each side, out to {range} units in front of it, over {cast_time} s, then sweeps it: {damage} physical damage and a small push to everyone inside."
icon_color = Color(1, 0.55, 0.25, 1)
targeting = 1
cooldown = 5.0
cast_time = 0.6
cast_range = 250.0
resets_auto_attack = false
base_damage = 55.0
hit_knockback_px = 16.0
hit_sound = ExtResource("4_hit")
telegraph_sound = ExtResource("5_telegraph")
ai_uses = Array[ExtResource("2_use")]([SubResource("use_damage"), SubResource("use_zone")])
