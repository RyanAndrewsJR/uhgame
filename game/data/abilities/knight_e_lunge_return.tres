[sub_resource type="Resource" id="stagger"]
script = ExtResource("3_bonus")
target_statuses = Array[ExtResource("4_status")]([ExtResource("5_staggered")])
description = "Staggers enemies hit for 2s."

[resource]
script = ExtResource("1_script")
dash_curve = ExtResource("2_curve")
id = &"knight_lunge_return"
tags = Array[StringName]([&"movement", &"mobility", &"dash", &"melee", &"blink"])
display_name = "Homeward Lunge"
supported_flags = Array[StringName]([&"lunge_stuns", &"lunge_tackle"])
variant_of = &"knight_lunge"
description = "Dash up to {range} units toward the target spot, passing through units and dealing {damage} physical damage ({base_damage} {ratios}) to every enemy you cut through. Recast within {recast_window}s to blink back to where you started (over walls; it hits nothing). The cooldown starts after the return."
icon_color = Color(0.45, 0.8, 1, 1)
targeting = 2
cooldown = 8.0
recast_count = 1
recast_window = 2.5
cast_time = 0.05
cast_range = 400.0
base_damage = 50.0
ad_ratio = 0.5
hit_shake = 2.5
conditional_bonuses = Array[ExtResource("3_bonus")]([SubResource("stagger")])
cast_sound = ExtResource("s1_cast_sound")
cast_anim = &"1H_Melee_Attack_Stab"
