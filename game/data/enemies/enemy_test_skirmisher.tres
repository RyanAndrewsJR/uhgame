[gd_resource type="Resource" script_class="EnemyData" format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_ability_slot.gd" id="1_slot"]
[ext_resource type="Resource" path="res://data/abilities/test_skirmisher_q_leap.tres" id="2_leap"]
[ext_resource type="Resource" path="res://data/abilities/test_skirmisher_w_stab.tres" id="3_stab"]
[ext_resource type="Resource" path="res://data/enemy_behaviors/enemy_behavior_skirmisher.tres" id="4_behavior"]
[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="5_data"]
