[ext_resource type="Resource" path="res://data/abilities/test_skirmisher_e_flurry.tres" id="7_flurry"]

[sub_resource type="Resource" id="slot_q"]
script = ExtResource("1_slot")
ability = ExtResource("2_leap")

[sub_resource type="Resource" id="slot_w"]
script = ExtResource("1_slot")
slot = &"w"
ability = ExtResource("3_stab")

[sub_resource type="Resource" id="slot_e"]
script = ExtResource("1_slot")
slot = &"e"
ability = ExtResource("7_flurry")

[resource]
script = ExtResource("5_data")
id = &"test_skirmisher"
display_name = "Test Skirmisher"
behavior = ExtResource("4_behavior")
stats = ExtResource("6_stats")
abilities = Array[ExtResource("1_slot")]([SubResource("slot_q"), SubResource("slot_w"), SubResource("slot_e")])
model_color = Color(0.95, 0.75, 0.25, 1)
