[gd_resource type="Resource" script_class="Talent" format=3]

[ext_resource type="Script" path="res://scripts/data/talent.gd" id="1_talent"]
[ext_resource type="Script" path="res://scripts/data/talent_requirement.gd" id="2_req"]
[ext_resource type="Script" path="res://scripts/data/stat_modifier.gd" id="3_mod"]
[sub_resource type="Resource" id="req_level"]
script = ExtResource("2_req")
amount = 2

[sub_resource type="Resource" id="req_use"]
script = ExtResource("2_req")
kind = 1
amount = 20

[sub_resource type="Resource" id="m_range"]
script = ExtResource("3_mod")
stat = &"cast_range"
type = 1
value = 0.3
scope = &"ability:knight_judgement"
[resource]
script = ExtResource("1_talent")
display_name = "Long Arm"
description = "Judgement's range is 30% longer."
modifiers = Array[ExtResource("3_mod")]([SubResource("m_range")])
id = &"knight_long_arm"
group = 3
tier = 1
requirements = Array[ExtResource("2_req")]([SubResource("req_level"), SubResource("req_use")])
