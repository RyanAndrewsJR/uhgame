[gd_resource type="Resource" script_class="StatusEffect" format=3]

[ext_resource type="Script" path="res://scripts/data/status_effect.gd" id="1_status"]
[ext_resource type="Script" path="res://scripts/data/stat_modifier.gd" id="2_modifier"]
[ext_resource type="Resource" path="res://data/sounds/sound_status_slow_apply.tres" id="s1_apply_sound"]

[sub_resource type="Resource" id="slow_move_speed"]
script = ExtResource("2_modifier")
stat = &"move_speed"
type = 1
value = -0.3

[resource]
script = ExtResource("1_status")
apply_sound = ExtResource("s1_apply_sound")
id = &"slow"
display_name = "Slowed"
tags = Array[StringName]([&"cc", &"slow", &"debuff"])
duration = 1.5
stack_rule = 1
modifiers = Array[ExtResource("2_modifier")]([SubResource("slow_move_speed")])
