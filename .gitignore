# ---------- Godot 4 ----------
# Editor cache + imported asset data. Regenerated when the project opens.
# Covers game/.godot/ (pattern matches at any depth).
.godot/

# Android build template, installed by the editor on demand.
/game/android/

# Export credentials (Godot 4.3+ keeps them inside .godot/; this catches stray copies).
export_credentials.cfg

# Translations compiled from CSV on import.
*.translation

# C#/Mono build output (project is GDScript-only; harmless safety net).
.mono/
data_*/
mono_crash.*.json

# Temp files Godot/editors write during save.
*.tmp

# DO commit: *.import, *.uid, project.godot, export_presets.cfg.
# Godot 4.4+ needs .uid files in version control or resource references break.

# ---------- OS junk ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- Claude outputs ----------
# Scratch images/comparisons. Decisions live in docs/, not here.
Claude outputs/
